{
  "name": "temp-app2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "prisma generate && next build --webpack",
    "dev": "next dev --webpack -p 2001",
    "dev:turbo": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "seed:superadmin": "tsx --env-file-if-exists=.env scripts/seed-superadmin.ts",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "backfill:schools": "tsx --env-file-if-exists=.env scripts/backfill-school-normalized-names.ts",
    "audit:nis": "tsx --env-file-if-exists=.env scripts/backfill-student-canonical-nis.ts",
    "seed:teacher-bambang": "tsx --env-file-if-exists=.env scripts/seed-teacher-bambang.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-presigned-post": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.18.0",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@milkdown/theme-nord": "^7.22.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.127",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pizzip": "^3.2.0",
    "posthog-js": "^1.438.21",
    "pptxgenjs": "^3.12.0",
    "rclone.js": "^0.6.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/exceljs": "^0.5.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "rclone.js@0.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
