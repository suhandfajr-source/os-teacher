# Development Stage 00 Placeholders

DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GEMINI_API_KEY=

# --- Zhipu AI GLM Configuration ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4-plus

# --- Student portal PIN pepper (required in production) ---
# Secret mixed into student PIN hashing (HMAC before scrypt). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# WARNING: rotating this value invalidates ALL existing student PIN hashes.
# Any process running this code with NODE_ENV=production fails at the first
# import of the PIN module — including build/CI when routes importing it are
# prerendered — so production-mode environments need this set. Development and
# test fall back to a deterministic constant when unset.
PIN_PEPPER=

# --- Superadmin allowlist (platform backstop) ---
# Comma-separated emails promoted to platformRole=ADMIN by:
#   npm run seed:superadmin
# Registration can NEVER grant ADMIN — only this env. Idempotent; every
# promotion writes an AuditLog entry. Removing an email does NOT demote the
# user (the seeder reports the drift as a warning); demotion stays a manual,
# deliberate decision. Local DB only. Requires Node >= 20.12.
SUPERADMIN_EMAILS=

# --- AI Slide Illustration (optional, requires Gemini paid tier) ---
# Uncomment to enable AI image generation for key presentation slides.
# Without it, exports fall back to the themed illustration panel.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Assignment file storage (S3-compatible: Cloudflare R2 / SeaweedFS) ---
# Browser siswa mengunggah langsung ke storage via presigned POST.
# Cloudflare R2 (gratis 10GB): endpoint = https://<account-id>.r2.cloudflarestorage.com
#   Catatan R2: set CORS bucket (AllowedOrigins = origin aplikasi, methods
#   GET/PUT/POST, AllowedHeaders *) agar upload browser tidak diblokir.
# Lokal tanpa cloud: SeaweedFS (pengganti MinIO yang sudah terarsip):
#   weed.exe server -ip=127.0.0.1 -dir=data -s3 -s3.port=8333 -s3.config=s3.json
#   (kredensial diambil dari file identitas s3.json, lihat docs/product/assignment-file-blueprint.md)
# Tanpa blok ini, fitur file tugas mati anggun — teks/link tetap jalan.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
