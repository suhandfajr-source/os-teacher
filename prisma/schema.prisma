// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------
// ENUMS (STAGE 02)
// -------------------------------------------------

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

// -------------------------------------------------
// BETTER AUTH SCHEMA
// -------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  teacherProfile TeacherProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// -------------------------------------------------
// SCHOOL WORKSPACE SCHEMA (DEV STAGE 02)
// -------------------------------------------------

model School {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  city           String?
  province       String?
  npsn           String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    TeacherSchoolMembership[]
  students       Student[]
  academicPeriods AcademicPeriod[]
  subjects       Subject[]
  classes        Class[]
  teachingContexts TeachingContext[]

  @@index([normalizedName])
  @@index([npsn])
  @@map("school")
}

model TeacherSchoolMembership {
  id               String           @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status           MembershipStatus @default(ACTIVE)
  workspaceRole    WorkspaceRole    @default(MEMBER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([teacherProfileId, schoolId])
  @@index([status])
  @@map("teacher_school_membership")
}

model Student {
  id                        String       @id @default(cuid())
  schoolId                  String
  school                    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fullName                  String
  nis                       String?
  status                    EntityStatus @default(ACTIVE)
  createdByTeacherProfileId String?
  updatedByTeacherProfileId String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  classMemberships          ClassStudent[]

  @@unique([schoolId, nis])
  @@index([fullName])
  @@map("student")
}

model ClassStudent {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, academicPeriodId])
  @@index([classId, academicPeriodId])
  @@map("class_student")
}

// -------------------------------------------------
// TEACHER SETUP SCHEMA (DEV STAGE 01)
// -------------------------------------------------

model TeacherProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchoolId      String?
  preferredName       String?
  onboardingCompleted Boolean  @default(false)

  memberships      TeacherSchoolMembership[]
  teachingContexts TeachingContext[]

  @@map("teacher_profile")
}

model AcademicPeriod {
  id               String           @id @default(cuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year             String
  semester         String
  status           String           // e.g., "ACTIVE", "INACTIVE"
  entityStatus     EntityStatus     @default(ACTIVE)
  teachingContexts TeachingContext[]
  classStudents    ClassStudent[]

  @@unique([schoolId, year, semester])
  @@map("academic_period")
}

model Subject {
  id               String           @id @default(cuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  normalizedName   String?
  shortName        String?
  status           EntityStatus     @default(ACTIVE)
  teachingContexts TeachingContext[]

  @@unique([schoolId, normalizedName])
  @@map("subject")
}

model Class {
  id               String           @id @default(cuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  normalizedName   String?
  gradeLevel       String?
  status           EntityStatus     @default(ACTIVE)
  teachingContexts TeachingContext[]
  classStudents    ClassStudent[]

  @@unique([schoolId, normalizedName])
  @@map("class")
}

model TeachingContext {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, schoolId, academicPeriodId, subjectId, classId])
  @@map("teaching_context")
}
