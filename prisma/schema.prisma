model AiUsageCounter {
  id               String   @id @default(cuid())
  teacherProfileId String
  usageDate        String // YYYY-MM-DD kalender WIB (Asia/Jakarta)
  count            Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([teacherProfileId, usageDate])
  @@index([usageDate])
  @@map("ai_usage_counter")
}

model TeacherAiKey {
  id               String   @id @default(cuid())
  teacherProfileId String   @unique
  provider         String   // "google" | "openai-compatible"
  encryptedApiKey  String   @db.Text
  customModel      String?
  baseURL          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@map("teacher_ai_key")
}

model TeacherCredit {
  id               String   @id @default(cuid())
  teacherProfileId String   @unique
  balance          Int      @default(50000) // 50.000 token = 50 kredit
  dailyAllowance   Int      @default(50000) // reset harian default 50 kredit
  lastResetDate    String?  // YYYY-MM-DD (Asia/Jakarta)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@map("teacher_credit")
}

model TeacherCreditLedger {
  id               String   @id @default(cuid())
  teacherProfileId String
  feature          String   // "AGENT" | "AI_STUDIO" | "QUIZ_GEN" | "TOPUP"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  creditCost       Float    @default(0) // totalTokens / 1000
  modelUsed        String?
  isByok           Boolean  @default(false)
  createdAt        DateTime @default(now())

  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, createdAt])
  @@map("teacher_credit_ledger")
}

model SystemSetting {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

// -------------------------------------------------
// BUG REPORT & TICKETING
// -------------------------------------------------

enum BugReportCategory {
  UI_UX
  FEATURE_ERROR
  AI_AGENT
  AUTHENTICATION
  PERFORMANCE
  OTHER
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BugReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model BugReport {
  id             String            @id @default(cuid())
  ticketNumber   String            @unique
  userId         String?
  reporterEmail  String?
  title          String
  description    String            @db.Text
  category       BugReportCategory @default(FEATURE_ERROR)
  status         BugReportStatus   @default(OPEN)
  priority       BugReportPriority @default(MEDIUM)
  pageUrl        String?
  deviceInfo     String?
  attachmentUrls String[]          @default([])
  adminNotes     String?           @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("bug_report")
}



