// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------
// ENUMS (STAGE 02)
// -------------------------------------------------

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

// -------------------------------------------------
// ENUMS (STAGE 03)
// -------------------------------------------------

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  SICK
  PERMISSION
  ABSENT
  LATE
}

enum AssignmentStatus {
  ACTIVE
  ARCHIVED
}

// -------------------------------------------------
// ENUMS (STAGE 04)
// -------------------------------------------------

enum AssessmentCategory {
  ASSIGNMENT
  FORMATIVE
  SUMMATIVE
  MIDTERM
  FINAL_TERM
  SCHOOL_EXAM
  PRACTICE
  PROJECT
  OTHER
}

enum GradePolicyStatus {
  DRAFT
  ACTIVE
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum AssessmentResultStatus {
  PENDING
  GRADED
  ABSENT
  EXCUSED
}

// -------------------------------------------------
// ENUMS (STAGE 06)
// -------------------------------------------------

enum AiContentType {
  LESSON_PLAN
  LEARNING_MATERIAL
  TASK_INSTRUCTION
  RUBRIC
}

enum AiDraftStatus {
  ACTIVE
  ARCHIVED
}

// -------------------------------------------------
// ENUMS (STAGE 07)
// -------------------------------------------------

enum AcademicPlanType {
  PROTA
  PROSEM
}

// -------------------------------------------------
// ENUMS (STAGE 08)
// -------------------------------------------------

enum ParentAccessStatus {
  ACTIVE
  REVOKED
}

enum ParentInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// -------------------------------------------------
// ENUMS (STAGE 09 - IMPORT & ONBOARDING)
// -------------------------------------------------

enum ImportCategory {
  ROSTER
  HISTORICAL_SESSION
  HISTORICAL_ATTENDANCE
  HISTORICAL_ASSESSMENT
}

// -------------------------------------------------
// BETTER AUTH SCHEMA
// -------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// -------------------------------------------------
// SCHOOL WORKSPACE SCHEMA (DEV STAGE 02)
// -------------------------------------------------

model School {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  city           String?
  province       String?
  npsn           String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      TeacherSchoolMembership[]
  students         Student[]
  academicPeriods  AcademicPeriod[]
  subjects         Subject[]
  classes          Class[]
  teachingContexts TeachingContext[]
  aiContentDrafts  AiContentDraft[]
  importSessions   ImportSession[]

  @@index([normalizedName])
  @@index([npsn])
  @@map("school")
}

model TeacherSchoolMembership {
  id               String           @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status           MembershipStatus @default(ACTIVE)
  workspaceRole    WorkspaceRole    @default(MEMBER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([teacherProfileId, schoolId])
  @@index([status])
  @@map("teacher_school_membership")
}

model Student {
  id                        String       @id @default(cuid())
  schoolId                  String
  school                    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fullName                  String
  nis                       String?
  status                    EntityStatus @default(ACTIVE)
  createdByTeacherProfileId String?
  updatedByTeacherProfileId String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  classMemberships  ClassStudent[]
  attendanceRecords AttendanceRecord[]
  assessmentResults AssessmentResult[]
  monitoringNotes   StudentMonitoringNote[]
  parentRelations   ParentStudentRelation[]
  parentInvitations ParentInvitation[]

  @@unique([schoolId, nis])
  @@index([fullName])
  @@map("student")
}

model ClassStudent {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, academicPeriodId])
  @@index([classId, academicPeriodId])
  @@map("class_student")
}

// -------------------------------------------------
// TEACHER SETUP SCHEMA (DEV STAGE 01)
// -------------------------------------------------

model TeacherProfile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchoolId      String?
  preferredName       String?
  onboardingCompleted Boolean @default(false)

  memberships                    TeacherSchoolMembership[]
  teachingContexts               TeachingContext[]
  aiContentDrafts                AiContentDraft[]
  createdParentInvitations       ParentInvitation[]     @relation("CreatedParentInvitations")
  grantedParentTeachingAccesses  ParentTeachingAccess[] @relation("GrantedParentTeachingAccesses")
  importSessions                 ImportSession[]

  @@map("teacher_profile")
}

model AcademicPeriod {
  id               String            @id @default(cuid())
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year             String
  semester         String
  status           String // e.g., "ACTIVE", "INACTIVE"
  entityStatus     EntityStatus      @default(ACTIVE)
  teachingContexts TeachingContext[]
  classStudents    ClassStudent[]

  @@unique([schoolId, year, semester])
  @@map("academic_period")
}

model Subject {
  id               String            @id @default(cuid())
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  normalizedName   String?
  shortName        String?
  status           EntityStatus      @default(ACTIVE)
  teachingContexts TeachingContext[]

  @@unique([schoolId, normalizedName])
  @@map("subject")
}

model Class {
  id               String            @id @default(cuid())
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  normalizedName   String?
  gradeLevel       String?
  status           EntityStatus      @default(ACTIVE)
  teachingContexts TeachingContext[]
  classStudents    ClassStudent[]

  @@unique([schoolId, normalizedName])
  @@map("class")
}

model TeachingContext {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  teachingSessions       TeachingSession[]
  assignments            Assignment[]
  assessmentTypes        AssessmentType[]
  gradePolicy            GradePolicy?
  assessments            Assessment[]
  monitoringNotes        StudentMonitoringNote[]
  aiContentDrafts        AiContentDraft[]
  academicContextProfile AcademicContextProfile?
  learningObjectives     LearningObjective[]
  academicPlanItems      AcademicPlanItem[]
  parentInvitations      ParentInvitation[]
  parentTeachingAccesses ParentTeachingAccess[]
  importSessions         ImportSession[]

  @@unique([teacherProfileId, schoolId, academicPeriodId, subjectId, classId])
  @@map("teaching_context")
}

// -------------------------------------------------
// DAILY TEACHING SCHEMA (DEV STAGE 03)
// -------------------------------------------------

model TeachingSession {
  id                   String          @id @default(cuid())
  teachingContextId    String
  teachingContext      TeachingContext @relation(fields: [teachingContextId], references: [id], onDelete: Cascade)
  date                 DateTime        @db.Date
  startedAt            DateTime?
  endedAt              DateTime?
  attendanceRecordedAt DateTime?
  plannedTopic         String?
  actualTopic          String?
  activitySummary      String?
  reflection           String?
  status               SessionStatus   @default(IN_PROGRESS)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  attendanceRecords      AttendanceRecord[]
  assignments            Assignment[]
  assessments            Assessment[]
  learningObjectiveLinks TeachingSessionLearningObjective[]

  @@index([teachingContextId])
  @@index([date])
  @@index([status])
  @@map("teaching_session")
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  teachingSessionId String
  teachingSession   TeachingSession  @relation(fields: [teachingSessionId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            AttendanceStatus
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([teachingSessionId, studentId])
  @@index([teachingSessionId])
  @@index([studentId])
  @@map("attendance_record")
}

model Assignment {
  id                String           @id @default(cuid())
  teachingContextId String
  teachingContext   TeachingContext  @relation(fields: [teachingContextId], references: [id], onDelete: Cascade)
  teachingSessionId String?
  teachingSession   TeachingSession? @relation(fields: [teachingSessionId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  dueDate           DateTime?
  status            AssignmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([teachingContextId])
  @@index([teachingSessionId])
  @@index([dueDate])
  @@map("assignment")
}

// -------------------------------------------------
// ASSESSMENT & GRADING SCHEMA (DEV STAGE 04)
// -------------------------------------------------

model AssessmentType {
  id                String             @id @default(cuid())
  teachingContextId String
  teachingContext   TeachingContext    @relation(fields: [teachingContextId], references: [id], onDelete: Cascade)
  name              String
  normalizedName    String
  category          AssessmentCategory @default(OTHER)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  assessments      Assessment[]
  gradePolicyItems GradePolicyItem[]

  @@unique([teachingContextId, normalizedName])
  @@index([teachingContextId, isActive])
  @@map("assessment_type")
}

model GradePolicy {
  id                String            @id @default(cuid())
  teachingContextId String            @unique
  teachingContext   TeachingContext   @relation(fields: [teachingContextId], references: [id], onDelete: Cascade)
  status            GradePolicyStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items GradePolicyItem[]

  @@index([teachingContextId, status])
  @@map("grade_policy")
}

model GradePolicyItem {
  id               String         @id @default(cuid())
  gradePolicyId    String
  gradePolicy      GradePolicy    @relation(fields: [gradePolicyId], references: [id], onDelete: Cascade)
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  weight           Decimal        @db.Decimal(5, 2)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([gradePolicyId, assessmentTypeId])
  @@index([gradePolicyId])
  @@index([assessmentTypeId])
  @@map("grade_policy_item")
}

model Assessment {
  id                         String           @id @default(cuid())
  teachingContextId          String
  teachingContext            TeachingContext  @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  assessmentTypeId           String
  assessmentType             AssessmentType   @relation(fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  teachingSessionId          String?
  teachingSession            TeachingSession? @relation(fields: [teachingSessionId], references: [id], onDelete: SetNull)
  title                      String
  description                String?
  assessmentDate             DateTime         @db.Date
  maxScore                   Decimal          @db.Decimal(10, 2)
  minimumPassingScore        Decimal?         @db.Decimal(5, 2)
  status                     AssessmentStatus @default(DRAFT)
  participantsInitializedAt DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  results                AssessmentResult[]
  learningObjectiveLinks AssessmentLearningObjective[]

  @@index([teachingContextId, status])
  @@index([teachingContextId, assessmentDate])
  @@index([assessmentTypeId])
  @@index([teachingSessionId])
  @@map("assessment")
}

model AssessmentResult {
  id              String                 @id @default(cuid())
  assessmentId    String
  assessment      Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  studentId       String
  student         Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status          AssessmentResultStatus @default(PENDING)
  rawScore        Decimal?               @db.Decimal(10, 2)
  normalizedScore Decimal?               @db.Decimal(5, 2)
  finalScore      Decimal?               @db.Decimal(5, 2)
  note            String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  remedialAttempts RemedialAttempt[]

  @@unique([assessmentId, studentId])
  @@index([assessmentId, status])
  @@index([studentId])
  @@map("assessment_result")
}

model RemedialAttempt {
  id                 String           @id @default(cuid())
  assessmentResultId String
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Restrict)
  score              Decimal          @db.Decimal(5, 2)
  note               String?
  attemptDate        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([assessmentResultId])
  @@index([attemptDate])
  @@map("remedial_attempt")
}

// -------------------------------------------------
// STUDENT MONITORING SCHEMA (DEV STAGE 05)
// -------------------------------------------------

model StudentMonitoringNote {
  id                String          @id @default(cuid())
  teachingContextId String
  teachingContext   TeachingContext @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  content           String          @db.Text
  requiresFollowUp  Boolean         @default(false)
  resolvedAt        DateTime?
  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([teachingContextId, isArchived])
  @@index([teachingContextId, studentId])
  @@index([studentId])
  @@index([requiresFollowUp, resolvedAt])
  @@map("student_monitoring_note")
}

// -------------------------------------------------
// AI CONTENT STUDIO SCHEMA (DEV STAGE 06)
// -------------------------------------------------

model AiContentDraft {
  id                String           @id @default(cuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacherProfileId  String
  teacherProfile    TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  teachingContextId String?
  teachingContext   TeachingContext? @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  contentType       AiContentType
  title             String
  topic             String
  instruction       String?          @db.Text
  content           String           @db.Text
  status            AiDraftStatus    @default(ACTIVE)
  modelUsed         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([teacherProfileId, schoolId, status])
  @@index([teachingContextId])
  @@index([contentType])
  @@map("ai_content_draft")
}

// -------------------------------------------------
// ACADEMIC CONTEXT SCHEMA (DEV STAGE 07)
// -------------------------------------------------

model AcademicContextProfile {
  id                String          @id @default(cuid())
  teachingContextId String          @unique
  teachingContext   TeachingContext @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  curriculumName    String?
  phase             String?
  academicNote      String?         @db.Text
  cpText            String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("academic_context_profile")
}

model LearningObjective {
  id                String          @id @default(cuid())
  teachingContextId String
  teachingContext   TeachingContext @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  code              String?
  description       String          @db.Text
  orderIndex        Int             @default(0)
  status            EntityStatus    @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sessionLinks      TeachingSessionLearningObjective[]
  assessmentLinks   AssessmentLearningObjective[]

  @@index([teachingContextId, status])
  @@index([teachingContextId, orderIndex])
  @@map("learning_objective")
}

model AcademicPlanItem {
  id                String           @id @default(cuid())
  teachingContextId String
  teachingContext   TeachingContext  @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  planType          AcademicPlanType
  title             String
  targetMonth       Int?
  allocatedHours    Int?
  notes             String?          @db.Text
  orderIndex        Int              @default(0)
  status            EntityStatus     @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([teachingContextId, planType, status])
  @@index([teachingContextId, orderIndex])
  @@map("academic_plan_item")
}

model TeachingSessionLearningObjective {
  id                  String            @id @default(cuid())
  teachingSessionId   String
  teachingSession     TeachingSession   @relation(fields: [teachingSessionId], references: [id], onDelete: Restrict)
  learningObjectiveId String
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)
  snapshotCode        String?
  snapshotDescription String            @db.Text
  createdAt           DateTime          @default(now())

  @@unique([teachingSessionId, learningObjectiveId])
  @@index([teachingSessionId])
  @@index([learningObjectiveId])
  @@map("teaching_session_learning_objective")
}

model AssessmentLearningObjective {
  id                  String            @id @default(cuid())
  assessmentId        String
  assessment          Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  learningObjectiveId String
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)
  snapshotCode        String?
  snapshotDescription String            @db.Text
  createdAt           DateTime          @default(now())

  @@unique([assessmentId, learningObjectiveId])
  @@index([assessmentId])
  @@index([learningObjectiveId])
  @@map("assessment_learning_objective")
}

// -------------------------------------------------
// PARENT PORTAL SCHEMA (DEV STAGE 08)
// -------------------------------------------------

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentRelations ParentStudentRelation[]
  acceptedInvites  ParentInvitation[]      @relation("AcceptedByParent")

  @@map("parent_profile")
}

model ParentStudentRelation {
  id                String        @id @default(cuid())
  parentProfileId   String
  parentProfile     ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Restrict)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  relationshipLabel String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  teachingAccesses ParentTeachingAccess[]

  @@unique([parentProfileId, studentId])
  @@index([studentId])
  @@map("parent_student_relation")
}

model ParentInvitation {
  id                          String                 @id @default(cuid())
  tokenHash                   String                 @unique
  recipientEmail              String
  relationshipLabel           String?
  studentId                   String
  student                     Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teachingContextId           String
  teachingContext             TeachingContext        @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  teacherProfileId            String
  teacherProfile              TeacherProfile         @relation("CreatedParentInvitations", fields: [teacherProfileId], references: [id], onDelete: Restrict)
  status                      ParentInvitationStatus @default(PENDING)
  expiresAt                   DateTime
  acceptedAt                  DateTime?
  acceptedByParentProfileId   String?
  acceptedByParentProfile     ParentProfile?         @relation("AcceptedByParent", fields: [acceptedByParentProfileId], references: [id], onDelete: Restrict)
  revokedAt                   DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@index([tokenHash])
  @@index([recipientEmail])
  @@index([teachingContextId, status])
  @@index([studentId])
  @@map("parent_invitation")
}

model ParentTeachingAccess {
  id                          String                 @id @default(cuid())
  parentStudentRelationId     String
  parentStudentRelation       ParentStudentRelation  @relation(fields: [parentStudentRelationId], references: [id], onDelete: Restrict)
  teachingContextId           String
  teachingContext             TeachingContext        @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  grantedByTeacherProfileId   String
  grantedByTeacherProfile     TeacherProfile         @relation("GrantedParentTeachingAccesses", fields: [grantedByTeacherProfileId], references: [id], onDelete: Restrict)
  status                      ParentAccessStatus     @default(ACTIVE)
  revokedAt                   DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@unique([parentStudentRelationId, teachingContextId])
  @@index([teachingContextId, status])
  @@map("parent_teaching_access")
}

// -------------------------------------------------
// IMPORT SESSION SCHEMA (DEV STAGE 09)
// -------------------------------------------------

model ImportSession {
  id                String           @id @default(cuid())
  tokenHash         String           @unique
  teacherProfileId  String
  teacherProfile    TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teachingContextId String?
  teachingContext   TeachingContext? @relation(fields: [teachingContextId], references: [id], onDelete: Restrict)
  category          ImportCategory
  payloadHash       String
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tokenHash])
  @@index([teacherProfileId, schoolId])
  @@index([teachingContextId, category])
  @@map("import_session")
}


